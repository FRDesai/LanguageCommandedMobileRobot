<?xml version="1.0"?>
<package format="3">
  <name>lcmr_agent</name>
  <version>0.1.0</version>
  <description>LLM agent that directs a mobile robot through six typed navigation tools.</description>
  <maintainer email="todo@example.com">Clitan Crasta</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
